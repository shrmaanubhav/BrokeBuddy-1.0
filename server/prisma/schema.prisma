generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String   @id @default(cuid())

  name               String
  email              String   @unique
  bankSenderEmail    String?
  bankSenderVerified Boolean  @default(false)

  googleId           String   @unique
  picture            String?

  googleRefreshToken String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  transactions       Transaction[]
  nicknames          Nickname[]
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  source          TransactionSource
  amount          Float
  debited         Boolean
  transactionDate DateTime
  category        ExpenseCategory   @default(OTHER)
  merchant        String?
  notes           String?
  upiId           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, amount, transactionDate, upiId])
  @@index([userId])
  @@index([transactionDate])
  @@index([source])
  @@index([upiId])
}

model Nickname {
  id       String @id @default(cuid())
  userId   String
  upiId    String
  nickname String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, upiId])
  @@index([userId])
  @@index([upiId])
}

enum TransactionSource {
  MANUAL
  EMAIL
}

enum ExpenseCategory {
  DINING
  TRAVEL
  SHOPPING
  BILLS
  SUBSCRIPTIONS
  OTHER
}