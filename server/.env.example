# Server Configuration
PORT=4000

# JWT Authentication
JWT_SECRET=your_jwt_secret_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
FRONTEND_URL=http://127.0.0.1:3000/BrokeBuddy

# Token encryption key for Gmail refresh tokens
TOKEN_ENCRYPTION_KEY=your_64_character_hex_key

# Python FastAPI parser service URL
PYTHON_API_URL=http://localhost:5000

# PostgreSQL Database
# Connection Pooler URL (used by Prisma Client)
DATABASE_URL=your_postgres_pooler_connection_url

# Direct Database URL (used by Prisma Migrations)
DIRECT_URL=your_postgres_direct_connection_url